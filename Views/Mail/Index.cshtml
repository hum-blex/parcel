@model IEnumerable<mail>
@{
    ViewData["Title"] = "Index";
}

<div class="container p-3">
    <div class="row pt-4">
    
        <div class="col-6">
            <h2 class="text-primary">Mail List</h2>
        </div>
        <div class="col-6 text-end">
            <a asp-controller="Mail" asp-action="Create" class="btn btn-primary">
                <i class="bi bi-pencil-fill"></i>  Compose
            </a>
        </div>
    </div>
    </br>



<table class="table table-bordered table-striped" style="width:100%">
    <thead>
        <tr>
            <th>
                From
            </th>
            <th>
                Subject
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach(var obj in Model)
        {
            <tr>
                <td width="50%">
                    @obj.From
                </td>
                <td width="50%">
                    @obj.Subject
                </td>
            </tr>
        }
    </tbody>
</table>
</div>